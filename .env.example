# Vites Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

ENV=development
APP_NAME=Vites

# Server URLs
IS_LOCAL_TESTING=false
LOCAL_IP_URL=http://your-pc-ip:8080
DEV_VPS_URL=https://dev.vites.iamsorry.in
PRODUCTION_BASE_URL=https://api.vites.iamsorry.in

# Billing Product IDs
PREMIUM_PRODUCT_KEY=premium_templates_pack
PREMIUM_PREF_KEY=is_premium_user

# Admin Access
# Add comma-separated Firebase UIDs
ADMIN_UIDS=
